# Orbyta Environment Variables
# Copy to .env and fill required values

# Flask Security
SECRET_KEY=super-secret-change-me-in-production!
FLASK_DEBUG=1  # Set 0 in production
SESSION_COOKIE_SECURE=0  # Set 1 with HTTPS
PREFERRED_URL_SCHEME=http  # Set https in production
TRUST_PROXY=1

# Server
HOST=0.0.0.0
PORT=5000
WAITRESS_THREADS=4

# App
APP_BASE_URL=http://127.0.0.1:5000  # Change to your domain
ORBYTA_DATA_DIR=./orbyta/data
ENABLE_REMINDER_WORKER=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Mercado Pago (uncomment and fill if using payments)
# MP_ACCESS_TOKEN=your_access_token_here
# MP_PUBLIC_KEY=your_public_key_here

# WhatsApp
WHATSAPP_PROVIDER=none  # none, twilio, webhook
# WHATSAPP_WEBHOOK_URL=https://your-webhook-url
# WHATSAPP_WEBHOOK_TOKEN=your_token

